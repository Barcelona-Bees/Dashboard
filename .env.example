# API base URL for the Vite dev server (browser → Express). Use your VM hostname in production.
VITE_API_BASE=http://localhost:3001

# Same origin the demo upload script calls (Node; not bundled into Vite).
API_URL=http://localhost:3001
# Must match Hive.passkey in Postgres (seed uses seed-demo-key).
HIVE_PASSKEY=seed-demo-key

# PostgreSQL — project default user/database (matches dbutils fallbacks).
# Copy to .env:  cp .env.example .env
#
# If the backend exits with "[db] Cannot connect", create role + database once:
#   npm run db:setup
# (uses: psql -U postgres — avoids "role <macOS username> does not exist")
#
# With schema loaded (database_initial.sql), demo sensor rows:
#   npm run db:seed
PGHOST=localhost
PGPORT=5432
PGDATABASE=siteinfo
PGUSER=student
PGPASSWORD=student
