## ===============================
## Barcelona Bees Dashboard env
## Copy to .env and adjust values
## ===============================

# Express API port (npm run dev:backend / npm start)
PORT=3001

# Browser -> API base URL (used at Vite build/dev time)
# Keep this as localhost when frontend and backend run on same machine.
VITE_API_BASE=http://localhost:3001

# Demo upload script target (npm run demo:push)
API_URL=http://localhost:3001

# Must match Hive.passkey in PostgreSQL (seed script uses seed-demo-key)
HIVE_PASSKEY=seed-demo-key

# Demo upload loop interval in ms (npm run demo:push -- --loop)
DEMO_PUSH_INTERVAL_MS=10000

# Home screen background fallback poll interval in ms (min 3000; default in code is 600000)
# VITE_HOME_POLL_MS=600000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=siteinfo
PGUSER=student
PGPASSWORD=student

# Optional Postgres SSL toggles (for managed cloud DBs)
# PGSSL=false
# PGSSLMODE=require

# Optional DB debug logging
# DEBUG_DB=1

# Optional backend test mode with live DB checks
# TEST_DB=1
