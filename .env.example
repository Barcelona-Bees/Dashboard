# Copy to .env for local dev. Docker / DigitalOcean: set equivalent env vars on the service.

# --- PostgreSQL (Express reads these via dbutils) ---
PGHOST=localhost
PGPORT=5432
PGUSER=student
PGPASSWORD=student
PGDATABASE=siteinfo

# --- API server ---
PORT=3001

# --- Vite (build-time; use empty for same-origin / Docker single container) ---
# VITE_API_BASE=
# VITE_HOME_POLL_MS=600000
